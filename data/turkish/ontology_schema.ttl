@prefix : <http://lexturca.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://lexturca.org/ontology> .

<http://lexturca.org/ontology> rdf:type owl:Ontology ;
                                rdfs:comment """Turkish Legal Knowledge Graph (TLKG) Ontology Extended for CivilLaw-MultiHop Benchmark
Incorporates Authority-Validity separation and Akoma Ntoso/LKIF-Core structural elements""" .

### Classes
:LegalSemanticUnit rdf:type owl:Class ; rdfs:comment "Base class for all discrete legal segments" .
:LegislativeProvision rdf:type owl:Class ; rdfs:subClassOf :LegalSemanticUnit .
:JudicialDecisionSegment rdf:type owl:Class ; rdfs:subClassOf :LegalSemanticUnit .

### Authority Properties
:hasAuthorityLevel rdf:type owl:ObjectProperty ;
                   rdfs:domain :LegalSemanticUnit ;
                   rdfs:range xsd:integer ;
                   rdfs:comment "Normative hierarchy level (1: Constitutional, 2: Code, etc.)" .
                   
:issuedBy rdf:type owl:ObjectProperty ;
          rdfs:domain :LegalSemanticUnit ;
          rdfs:range xsd:string .

### Temporal Validity Properties
:effectiveFrom rdf:type owl:DatatypeProperty ;
               rdfs:domain :LegalSemanticUnit ;
               rdfs:range xsd:dateTime .
               
:effectiveTo rdf:type owl:DatatypeProperty ;
             rdfs:domain :LegalSemanticUnit ;
             rdfs:range xsd:dateTime .

### Relationships 
:amends rdf:type owl:ObjectProperty ;
        rdfs:domain :LegislativeProvision ;
        rdfs:range :LegislativeProvision .

:interprets rdf:type owl:ObjectProperty ;
            rdfs:domain :JudicialDecisionSegment ;
            rdfs:range :LegislativeProvision .

:constitutesPrecedent rdf:type owl:ObjectProperty ;
                      rdfs:domain :JudicialDecisionSegment ;
                      rdfs:range :JudicialDecisionSegment .
